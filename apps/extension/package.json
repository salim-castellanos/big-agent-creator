{
  "name": "bigagentcreator",
  "displayName": "BigAgentCreator",
  "description": "Design an AI agent workflow on a canvas and save it as a folder. Triggers, tools, Telegram, and local Docker. Open the playground. Skip the agent and the path answers in code, with no model call.",
  "version": "0.2.0",
  "publisher": "SalimCastellanos",
  "icon": "media/icon.png",
  "galleryBanner": { "color": "#1A2332", "theme": "dark" },
  "keywords": ["ai agent", "agent workflow", "canvas", "telegram bot", "docker", "cursor", "tools", "playground", "webhook"],
  "engines": { "vscode": "^1.95.0" },
  "categories": ["AI"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "bigagent", "title": "BigAgentCreator", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "bigagent": [
        { "type": "webview", "id": "bigagent.home", "name": "Designer" }
      ]
    },
    "commands": [
      { "command": "bigagent.open", "title": "BigAgentCreator: Open designer" }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "test": "tsx --test src/project.test.ts"
  },
  "devDependencies": {
    "@types/vscode": "1.95.0",
    "esbuild": "0.25.0",
    "tsx": "4.20.3"
  }
}
